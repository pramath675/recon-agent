# Copy to .env and fill in. NEVER commit .env.
# Values come from the Nebius Token Factory console / docs. RECON does not guess them.
NEBIUS_API_KEY=your-api-key-here
NEBIUS_BASE_URL=paste-the-OpenAI-compatible-base-URL-from-the-Nebius-docs
NEBIUS_MODEL=paste-the-exact-NVIDIA-model-ID-from-the-Nebius-model-catalog

# Optional cost/safety limits (defaults shown)
RECON_MAX_API_CALLS=4
RECON_MAX_OUTPUT_TOKENS=1500
RECON_MAX_CONTEXT_CHARS=24000
RECON_HTTP_TIMEOUT=60
RECON_TEST_TIMEOUT=60
RECON_REPEATS=2
